# Optional overrides for docker-compose.yml. Copy to ".env" (same folder as
# docker-compose.yml) and fill in only what you need - everything here is
# blank/safe by default, so `docker compose up --build` works with none of
# this set. Compose reads ".env" automatically; it is not read by the app
# containers directly.

# Leave blank to log emails to storage/logs/laravel.log instead of sending
# them (fine for a demo - the seeded admin account is pre-verified). Set to
# "resend" + RESEND_API_KEY for real delivery during a live defense.
MAIL_MAILER=
RESEND_API_KEY=
MAIL_FROM_ADDRESS=

# Powers "Generate description" and the organizer feedback-summary AI
# feature. Blank is fine - both return a clean 503 instead of crashing.
GEMINI_API_KEY=

# Printed in application emails / shown on a pending applicant's status
# card. Blank falls back to the seeded admin account's own details.
ADMIN_CONTACT_NUMBER=
ADMIN_CONTACT_EMAIL=

# Enables the interactive Google map on event location pickers. Blank
# falls back to a plain text input + a free no-key Maps iframe embed.
VITE_GOOGLE_MAPS_API_KEY=
